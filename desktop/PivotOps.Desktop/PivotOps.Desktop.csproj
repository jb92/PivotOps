<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>PivotOps.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PivotOps.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Single-project MSIX packaging -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxBundle>Never</AppxBundle>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <DefaultLanguage>en-US</DefaultLanguage>

    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <WebPayloadDir>$(MSBuildThisFileDirectory)web\</WebPayloadDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\PivotOps.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The bundled web app is packaged under `web\` and served to WebView2 through a
    virtual host name. Items are added from a target so the glob is evaluated
    after the npm build has had a chance to produce its output.
  -->
  <Target Name="IncludeWebPayload" BeforeTargets="AssignTargetPaths" Condition="'$(_PivotOpsWebPayloadIncluded)' != 'true'">
    <Exec Command="npm run build:desktop"
          WorkingDirectory="$(RepoRoot)"
          Condition="!Exists('$(WebPayloadDir)taskpane.html')" />
    <Error Condition="!Exists('$(WebPayloadDir)taskpane.html')"
           Text="The PivotOps web payload is missing. Run 'npm run build:desktop' from the repository root." />
    <ItemGroup>
      <Content Include="web\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <PropertyGroup>
      <_PivotOpsWebPayloadIncluded>true</_PivotOpsWebPayloadIncluded>
    </PropertyGroup>
  </Target>

</Project>
